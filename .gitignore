# Deny root additions by default; publish only the reviewed allowlist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/CITATION.cff
!/THIRD_PARTY_NOTICES.txt
!/package.json
!/package-lock.json
!/netlify.toml
!/requirements.lock
!/index.html
!/publication_allowlist.json
!/src/
!/code/
!/scripts/
!/tests/
!/public/
!/data/
!/provenance/
!/LICENSES/
!/distribution/
/public/data/
/public/downloads/packages/
/data/native/
/data/master/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/.env*
**/*.pem
**/*.key
